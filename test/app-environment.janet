(use spork/test ../gp/data/schema)

(import ../gp/environment/app)
(start-suite "Documentation")
(assert-docs "../gp/environment/app")
(end-suite)

(start-suite "HTTP")
(assert ((?eq "a=b") (app/process-body "a=b")) "Process string body")
(assert ((?eq "a=b") (app/process-body {:a "b"})) "Process dict body")
(assert ((?deep-eq @{:a "b"}) (app/coerce-body {"a" " b "})) "Coerce body")
(end-suite)

(start-suite "Events")
(assert (((app/Dirty :update) nil @{}) :dirty) "Dirty sets flag")
(assert-not (((app/Clean :update) nil @{:dirty true}) :dirty) "Clean unsets flag")
(end-suite)

(start-suite "Test helpers")
(assert (app/success? {:status 200}) "HTTP success?")
(assert ((app/success-has? "pepe")
          {:status 200 :body "pepe"}) "HTTP success has in body")
(assert ((app/success-has-not? "pepe")
          {:status 200 :body "prepe"}) "HTTP success has not in body")
(assert ((app/redirect? "/home")
          {:status 303 :headers {"content-length" "0" "location" "/home"}}) "HTTP redirect?")
(assert (app/empty-success? {:status 200 :body ""}) "HTTP empty success?")
(end-suite)
