(use gp/tui spork/misc)

(defn main
  "Main program"
  [_ &opt prefix prompt]
  (default prefix "")
  (let [transform (if (empty? prefix)
                    identity (partial string/replace prefix ""))
        items (seq [line :iterate (file/read stdin :line)]
                (transform (string/trim line)))
        chooser (make-chooser items @{:prompt-format prompt})]
    (print (string prefix (:result (:render chooser))))))
