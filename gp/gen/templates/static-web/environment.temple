(import spork/misc :export true :prefix "")
(import gp/net/http :export true :prefix "")
(import gp/utils :export true :prefix "")
(import gp/events :export true :prefix "")
(import spork/temple :export true)
(import spork/path :export true)
(import spork/mdz :export true)
(import spork/htmlgen :export true)
(import spork/sh :export true)

(temple/add-loader)

(def new-file-name "new-file.mdz")

(defn mdz->html
  "Changes mdz to html externsion"
  [file &opt prefix]
  (default prefix "")
  (->> file
       (string/replace "content" prefix)
       (string/replace "mdz" "html")))

(defn process-css
  "Process css"
  [e]
  (def {:static s
        :css css
        :files {:css fcss}} e)
  (->>
    fcss
    (map |(string/replace (path/join s css) css $))
    (filter |(string/has-suffix? ".css" $))
    sort))
