{- `{% (def fnm (args :file-name)) (def new? (= fnm "new-file.mdz")) %}` -}
<form style="width: 60rem" action="/__dashboard/save" method="POST">
  <textarea name="file-content" cols="80" rows="20">{% (print `{- (args :file-content) -}`) %}</textarea>
  {% (print ```{- (if new? `<label for="name">File name</label>`) -}```) %}
  <input type={% (print ```{- (if new? (string `"text" placeholder="` fnm `"`) `"hidden"`) -}```) %}
    name="file-name" value="{{ `{- (unless new? fnm) -}` }}"/>
  <input type="submit" value="Save" />
  <a href="/__dashboard">Cancel</a>
</form>
